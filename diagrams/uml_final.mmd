classDiagram
    class Priority {
        <<enumeration>>
        HIGH
        MEDIUM
        LOW
        +rank() int
    }

    class Frequency {
        <<enumeration>>
        ONCE
        DAILY
        WEEKLY
    }

    class Owner {
        +String name
        +String preferences
        +String availableStart
        +String availableEnd
        +List~Pet~ pets
        +addPet()
        +updatePreferences()
        +setAvailableTime()
        +allTasks() List~Task~
        +availableMinutes() int
    }

    class Pet {
        +String name
        +String species
        +int age
        +String healthNotes
        +List careNeeds
        +List~Task~ tasks
        +addCareNeed()
        +addTask()
        +updateProfile()
        +getDailyRequirements()
    }

    class Task {
        +String title
        +String category
        +int durationMinutes
        +Priority priority
        +String preferredTime
        +Frequency frequency
        +Pet pet
        +bool completed
        +date dueDate
        +markComplete() Task
        +createNextOccurrence() Task
        +updateDuration()
        +changePriority()
        +isHighPriority()
        +fitsInTimeWindow()
    }

    class PlanItem {
        +Task task
        +int startMinutes
        +endMinutes() int
    }

    class Conflict {
        +Task taskA
        +Task taskB
        +samePet() bool
    }

    class Planner {
        +Owner owner
        +List~Pet~ pets
        +List~Task~ tasks
        +collectTasks()
        +sortTasks()
        +filterTasks() List~Task~
        +detectConflicts() List~Conflict~
        +explainConflicts() String
        +checkConflicts() String
        +generatePlan() List~PlanItem~
        +resolveConflicts()
        +explainPlan() String
    }

    Owner "1" --> "1..*" Pet : owns
    Pet "1" --> "0..*" Task : has
    Task "0..*" --> "1" Pet : belongs to
    Task --> Priority
    Task --> Frequency
    PlanItem "1" --> "1" Task : schedules
    Conflict "1" --> "2" Task : flags
    Planner --> Owner
    Planner "1" --> "1..*" Pet
    Planner ..> PlanItem : produces
    Planner ..> Conflict : detects
