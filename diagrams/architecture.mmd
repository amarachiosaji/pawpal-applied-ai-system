flowchart TD
    subgraph Input["User Input"]
        A1[Owner sets availability]
        A2[Add Pet: name, species, age]
        A3[Add Task: title, category,<br/>duration, priority, time, frequency]
    end

    subgraph Core["Core Scheduling System (Planner)"]
        B1[collect_tasks<br/>flatten all pets' tasks via Owner]
        B2[sort_tasks<br/>priority, then preferred time]
        B3[detect_conflicts / check_conflicts<br/>overlapping time windows]
        B4[generate_plan<br/>conflict-free schedule]
    end

    subgraph RAG["RAG Layer - NEW"]
        C1[RAGRetriever.retrieve<br/>query = title + category + species]
        C2[(Knowledge Base<br/>knowledge slash star dot md<br/>TF-IDF vector space)]
        C3{Similarity score gte 0.10}
        C4[Return top-matching<br/>care tip + source + score]
        C5[Guardrail fallback:<br/>No specific guidance found]
    end

    subgraph Output["Output"]
        D1[CLI: main.py<br/>printed schedule + tips]
        D2[Streamlit UI: app.py<br/>tables + expandable tip cards]
    end

